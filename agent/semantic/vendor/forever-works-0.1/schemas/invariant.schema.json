{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forever.works/schemas/0.1/invariant.schema.json",
  "title": "Invariant",
  "description": "Canonical Forever Works invariant record. Unknown fields are preserved for compatible extension.",
  "type": "object",
  "required": [
    "foreverVersion",
    "id",
    "kind",
    "name",
    "statement",
    "severity"
  ],
  "properties": {
    "foreverVersion": {
      "type": "string",
      "pattern": "^0\\\\.[0-9]+$",
      "description": "Forever Works schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Stable, globally unique entity identifier."
    },
    "kind": {
      "const": "invariant"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "name": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/verification"
      }
    },
    "thresholds": {
      "type": "object"
    },
    "changePolicy": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "relatedCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "foreverVersion": "0.1",
      "id": "invariant.example",
      "kind": "invariant",
      "name": "Example",
      "statement": "Remain true.",
      "severity": "high"
    }
  ]
}
