{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forever.works/schemas/0.1/constraint.schema.json",
  "title": "Constraint",
  "description": "Canonical Forever Works constraint record. Unknown fields are preserved for compatible extension.",
  "type": "object",
  "required": [
    "foreverVersion",
    "id",
    "kind",
    "statement",
    "category",
    "classification"
  ],
  "properties": {
    "foreverVersion": {
      "type": "string",
      "pattern": "^0\\\\.[0-9]+$",
      "description": "Forever Works schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Stable, globally unique entity identifier."
    },
    "kind": {
      "const": "constraint"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "statement": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "classification": {
      "enum": [
        "hard",
        "soft"
      ]
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/verification"
      }
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "foreverVersion": "0.1",
      "id": "constraint.example",
      "kind": "constraint",
      "statement": "Use open formats.",
      "category": "portability",
      "classification": "hard"
    }
  ]
}
