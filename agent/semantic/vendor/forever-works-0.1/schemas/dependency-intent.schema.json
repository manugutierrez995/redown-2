{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forever.works/schemas/0.1/dependency.schema.json",
  "title": "Dependency",
  "description": "Canonical Forever Works dependency record. Unknown fields are preserved for compatible extension.",
  "type": "object",
  "required": [
    "foreverVersion",
    "id",
    "kind",
    "dependencyName",
    "dependencyType",
    "purpose",
    "reasonSelected",
    "replacementClassification"
  ],
  "properties": {
    "foreverVersion": {
      "type": "string",
      "pattern": "^0\\\\.[0-9]+$",
      "description": "Forever Works schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Stable, globally unique entity identifier."
    },
    "kind": {
      "const": "dependency"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "dependencyName": {
      "type": "string"
    },
    "dependencyType": {
      "type": "string"
    },
    "currentImplementation": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "reasonSelected": {
      "type": "string"
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "protectedInvariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "relatedConstraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "replacementClassification": {
      "enum": [
        "LOCKED",
        "SEMANTIC",
        "CAPABILITY",
        "TRANSITIONAL",
        "LEGACY",
        "OPTIONAL"
      ]
    },
    "replacementRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "compatibilityObligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "historicalContext": {
      "type": "string"
    },
    "deprecationState": {
      "type": "string"
    },
    "revisitCondition": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "foreverVersion": "0.1",
      "id": "dependency.example",
      "kind": "dependency",
      "dependencyName": "example",
      "dependencyType": "library",
      "purpose": "Provide work.",
      "reasonSelected": "Available.",
      "replacementClassification": "CAPABILITY"
    }
  ]
}
