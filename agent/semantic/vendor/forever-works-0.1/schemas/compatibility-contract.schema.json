{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forever.works/schemas/0.1/compatibility.schema.json",
  "title": "Compatibility",
  "description": "Canonical Forever Works compatibility record. Unknown fields are preserved for compatible extension.",
  "type": "object",
  "required": [
    "foreverVersion",
    "id",
    "kind",
    "contractType",
    "boundary",
    "mustPreserve",
    "migrationPolicy",
    "version"
  ],
  "properties": {
    "foreverVersion": {
      "type": "string",
      "pattern": "^0\\\\.[0-9]+$",
      "description": "Forever Works schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "description": "Stable, globally unique entity identifier."
    },
    "kind": {
      "const": "compatibility"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "contractType": {
      "enum": [
        "API",
        "ABI",
        "file-format",
        "save-format",
        "command-line",
        "protocol",
        "plugin-interface",
        "database-schema",
        "import-export"
      ]
    },
    "boundary": {
      "type": "string"
    },
    "mustPreserve": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "mayChange": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    },
    "migrationPolicy": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "validationReferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Stable entity ID references."
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "foreverVersion": "0.1",
      "id": "compatibility.example",
      "kind": "compatibility",
      "contractType": "file-format",
      "boundary": "JSON files",
      "mustPreserve": [
        "Readable"
      ],
      "migrationPolicy": "Non-destructive",
      "version": "1"
    }
  ]
}
